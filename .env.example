# Copie para .env (cp .env.example .env) e ajuste os valores. NUNCA versione o .env.
POSTGRES_DB=esg
POSTGRES_USER=esg_user
POSTGRES_PASSWORD=troque_esta_senha
STAGING_PORT=8081
PRODUCTION_PORT=8082
# Nome da imagem (deve ser minúsculo). No CI é sobrescrito por ghcr.io/<dono>/cidades-esg-inteligentes:<sha>
IMAGE_NAME=cidades-esg-inteligentes:local
